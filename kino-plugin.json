{
  "id": "theme-naruto-shippuden",
  "name": "Naruto Shippuden",
  "version": "1.0.1",
  "apiVersion": 26,
  "entry": "plugin.js",
  "description": "Tema Naruto Shippuden: naranja, azul noche y logo ninja",
  "hosts": [],
  "categories": ["themes"],
  "appThemes": [
    {
      "id": "naruto-shippuden",
      "name": { "es": "Naruto Shippuden", "en": "Naruto Shippuden" },
      "experience": "full",
      "colors": {
        "accent": "#FF7A00",
        "onAccent": "#000000",
        "background": "#0A1428",
        "surface": "#131C2E",
        "surfaceHigh": "#1C2740",
        "railPanel": "#0F1830",
        "textPrimary": "#F5F5F5",
        "textSecondary": "#B8C0D0",
        "focus": "#FFB300",
        "onFocus": "#000000",
        "outline": "#2A3A5C",
        "border": "#2B4A8C",
        "favorite": "#FF7A00"
      },
      "background": {
        "type": "gradient",
        "colors": ["#0A1428", "#101C3A", "#2B1406"],
        "angle": 160
      },
      "shape": {
        "cardRadius": 14, "channelRadius": 14, "buttonRadius": 22,
        "chipRadius": 20, "dialogRadius": 20, "inputRadius": 12,
        "heroRadius": 20, "railItemRadius": 16,
        "dialogBorder": 1, "cardBorder": 0, "headerBorder": 1
      },
      "typography": { "scale": 1.05, "titleScale": 1.1, "bodyScale": 1.0 },
      "elevation": { "cardShadow": 0.5, "dialogShadow": 0.7 },
      "motion": { "focusZoom": 1.08, "crossfadeMs": 300, "heroDrift": "on" },
      "player": { "buttonScale": 1.1, "playButtonScale": 1.3, "seekBarScale": 1.3, "buttonShape": "circle" },
      "style": { "gloss": 0.4 },
      "layout": { "hero": "framed", "rail": "floating" },
      "surfaces": {
        "button": {
          "fill": { "type": "gradient", "colors": ["#FFA024", "#E85D00"], "angle": 180 },
          "stroke": { "width": 1, "color": "#FFC570" }
        },
        "navActive": {
          "fill": { "type": "gradient", "colors": ["#FF9A1F", "#E85D00"], "angle": 180 },
          "glow": { "color": "#FF7A00", "radius": 10, "alpha": 0.55 }
        },
        "cardFocus": {
          "stroke": { "width": 2, "color": "#FFB300" },
          "glow": { "color": "#FF7A00", "radius": 14, "alpha": 0.5 }
        },
        "card": { "glow": { "color": "#2B4A8C", "radius": 8, "alpha": 0.25 } },
        "hero": { "stroke": { "width": 1.5, "color": "#FF7A00" }, "glow": { "color": "#FF7A00", "radius": 12, "alpha": 0.3 } },
        "rail": { "stroke": { "width": 1, "color": "#2B4A8C" } },
        "progress": { "fill": { "type": "gradient", "colors": ["#FFB300", "#FF7A00"], "angle": 0 } }
      },
      "logo": {
        "wordmark": {
          "size": [120, 30],
          "paths": [
            { "d": "M15 0 A15 15 0 1 1 14.99 0 Z", "fill": "accent" },
            { "d": "M15 4.5 A10.5 10.5 0 1 1 14.99 4.5 Z", "fill": "#0A1428" },
            { "d": "M15 8 A7 7 0 1 1 14.99 8 Z", "fill": "accent" },
            { "d": "M9 18 Q15 6 23 10 Q17 12 9 18 Z", "fill": "#0A1428" },
            { "d": "M40 4 H110 L104 12 H40 Z", "fill": "accent" },
            { "d": "M40 18 H96 L90 26 H40 Z", "fill": "textPrimary" },
            { "d": "M98 18 H116 L110 26 H92 Z", "fill": "#2B4A8C" }
          ]
        },
        "mark": {
          "size": [30, 30],
          "paths": [
            { "d": "M15 0 A15 15 0 1 1 14.99 0 Z", "fill": "accent" },
            { "d": "M15 4.5 A10.5 10.5 0 1 1 14.99 4.5 Z", "fill": "#0A1428" },
            { "d": "M15 8 A7 7 0 1 1 14.99 8 Z", "fill": "accent" },
            { "d": "M9 18 Q15 6 23 10 Q17 12 9 18 Z", "fill": "#0A1428" }
          ]
        }
      },
      "adjustable": {
        "colors.accent": { "swatches": ["#FF7A00", "#FFB300", "#2B7BFF", "#E5192E"] },
        "shape.cardRadius": { "min": 0, "max": 24 },
        "typography.scale": { "min": 0.95, "max": 1.25 },
        "background": true
      }
    }
  ]
}
