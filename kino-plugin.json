{
  "id": "theme-neon",
  "name": "Neón",
  "version": "1.1.0",
  "apiVersion": 26,
  "entry": "plugin.js",
  "description": "Tema oscuro con acentos neón",
  "hosts": [],
  "categories": ["themes"],
  "appThemes": [
    {
      "id": "neon",
      "name": { "es": "Neón", "en": "Neon" },
      "experience": "full",
      "colors": {
        "accent": "#00E5FF",
        "onAccent": "#000000",
        "background": "#0A0A14",
        "surface": "#14142A",
        "surfaceHigh": "#1E1E3A",
        "textPrimary": "#F2F4FF",
        "textSecondary": "#A8B0CC",
        "focus": "#FFFFFF",
        "onFocus": "#000000",
        "outline": "#2A2A4A",
        "border": "#2E2E52",
        "railPanel": "#101026"
      },
      "background": {
        "type": "gradient",
        "colors": ["#0A0A14", "#1A0A2E"],
        "angle": 180
      },
      "shape": {
        "cardRadius": 14,
        "channelRadius": 14,
        "buttonRadius": 24,
        "chipRadius": 20,
        "dialogRadius": 20,
        "inputRadius": 12,
        "cardBorder": 1,
        "dialogBorder": 2,
        "headerBorder": 1,
        "heroRadius": 20,
        "railItemRadius": 14
      },
      "typography": {
        "scale": 1.05,
        "titleScale": 1.05,
        "bodyScale": 1.0
      },
      "elevation": {
        "cardShadow": 0.6,
        "dialogShadow": 0.8,
        "heroScrim": 0.7
      },
      "motion": {
        "focusZoom": 1.06,
        "crossfadeMs": 200,
        "heroDrift": "on"
      },
      "player": {
        "buttonScale": 1,
        "playButtonScale": 1.1,
        "seekBarScale": 1,
        "labelScale": 1,
        "buttonShape": "circle"
      },
      "style": {
        "gloss": 0.35
      },
      "surfaces": {
        "button": {
          "fill": { "type": "gradient", "colors": ["#00E5FF", "#0088AA"], "angle": 180 },
          "stroke": { "width": 1, "color": "#7CF0FF" }
        },
        "navActive": {
          "fill": { "type": "solid", "color": "#14142A" },
          "stroke": { "width": 1.5, "color": "#00E5FF" },
          "glow": { "color": "#00E5FF", "radius": 10, "alpha": 0.5 }
        },
        "cardFocus": {
          "stroke": { "width": 2, "color": "#FFFFFF" },
          "glow": { "color": "#00E5FF", "radius": 14, "alpha": 0.45 }
        },
        "card": {
          "glow": { "color": "#00E5FF", "radius": 8, "alpha": 0.18 }
        }
      },
      "layout": {
        "hero": "framed",
        "rail": "floating"
      },
      "tv": {
        "typography": { "scale": 1.0 },
        "layout": { "hero": "framed", "rail": "floating" }
      },
      "adjustable": {
        "colors.accent": { "swatches": ["#00E5FF", "#7C4DFF", "#FFB300"] },
        "shape.cardRadius": { "min": 0, "max": 20 },
        "typography.scale": { "min": 1.0, "max": 1.3 },
        "background": true
      }
    }
  ]
}
