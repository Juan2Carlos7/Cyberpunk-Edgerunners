{
  "id": "theme-neon",
  "name": "Neón",
  "version": "1.2.0",
  "apiVersion": 26,
  "entry": "plugin.js",
  "description": "Tema oscuro con acentos neón",
  "hosts": [],
  "categories": ["themes"],
  "appThemes": [
    {
      "id": "neon",
      "name": { "es": "Neón", "en": "Neon" },
      "experience": "full",
      "colors": {
        "accent": "#00E5FF",
        "onAccent": "#000000",
        "background": "#0A0A14",
        "surface": "#14142A",
        "surfaceHigh": "#1E1E3A",
        "textPrimary": "#F2F4FF",
        "textSecondary": "#A8B0CC",
        "focus": "#FFFFFF",
        "onFocus": "#000000",
        "outline": "#2A2A4A",
        "border": "#2E2E52",
        "railPanel": "#101026"
      },
      "background": {
        "type": "gradient",
        "colors": ["#0A0A14", "#1A0A2E"],
        "angle": 180
      },
      "shape": {
        "cardRadius": 14,
        "channelRadius": 14,
        "buttonRadius": 24,
        "chipRadius": 20,
        "dialogRadius": 20,
        "inputRadius": 12,
        "cardBorder": 1,
        "dialogBorder": 2,
        "headerBorder": 1,
        "heroRadius": 20,
        "railItemRadius": 14
      },
      "typography": {
        "scale": 1.05,
        "titleScale": 1.05,
        "bodyScale": 1.0
      },
      "elevation": {
        "cardShadow": 0.6,
        "dialogShadow": 0.8,
        "heroScrim": 0.7
      },
      "motion": {
        "focusZoom": 1.06,
        "crossfadeMs": 200,
        "heroDrift": "on"
      },
      "player": {
        "buttonScale": 1,
        "playButtonScale": 1.1,
        "seekBarScale": 1,
        "labelScale": 1,
        "buttonShape": "circle"
      },
      "style": {
        "gloss": 0.35
      },
      "surfaces": {
        "button": {
          "fill": { "type": "gradient", "colors": ["#00E5FF", "#0088AA"], "angle": 180 },
          "stroke": { "width": 1, "color": "#7CF0FF" }
        },
        "navActive": {
          "fill": { "type": "solid", "color": "#14142A" },
          "stroke": { "width": 1.5, "color": "#00E5FF" },
          "glow": { "color": "#00E5FF", "radius": 10, "alpha": 0.5 }
        },
        "cardFocus": {
          "stroke": { "width": 2, "color": "#FFFFFF" },
          "glow": { "color": "#00E5FF", "radius": 14, "alpha": 0.45 }
        },
        "card": {
          "glow": { "color": "#00E5FF", "radius": 8, "alpha": 0.18 }
        }
      },
      "layout": {
        "hero": "framed",
        "rail": "floating"
      },
      "tv": {
        "typography": { "scale": 1.0 },
        "layout": { "hero": "framed", "rail": "floating" }
      },
      "adjustable": {
        "colors.accent": { "swatches": ["#00E5FF", "#9B7CFF", "#FFB300", "#FF3B6B"] },
        "colors.surface": { "swatches": ["#14142A", "#0F1A24", "#1A1224", "#101010"] },
        "colors.surfaceHigh": { "swatches": ["#1E1E3A", "#16283A", "#241A38", "#1A1A1A"] },
        "colors.railPanel": { "swatches": ["#101026", "#0A1A20", "#180A20", "#0A0A0A"] },
        "colors.border": { "swatches": ["#2E2E52", "#3A2A5C", "#1E3A44", "#000000"] },
        "colors.focus": { "swatches": ["#FFFFFF", "#00E5FF", "#FFB300", "#9B7CFF"] },
        "colors.textSecondary": { "swatches": ["#A8B0CC", "#B8C0D8", "#8E9AB8", "#C4C8D4"] },
        "shape.cardRadius": { "min": 0, "max": 24 },
        "shape.channelRadius": { "min": 0, "max": 24 },
        "shape.buttonRadius": { "min": 0, "max": 32 },
        "shape.chipRadius": { "min": 0, "max": 32 },
        "shape.dialogRadius": { "min": 0, "max": 32 },
        "shape.inputRadius": { "min": 0, "max": 32 },
        "shape.heroRadius": { "min": 0, "max": 32 },
        "shape.railItemRadius": { "min": 0, "max": 24 },
        "shape.cardBorder": { "min": 0, "max": 4 },
        "shape.dialogBorder": { "min": 0, "max": 4 },
        "shape.headerBorder": { "min": 0, "max": 4 },
        "typography.scale": { "min": 0.85, "max": 1.3 },
        "typography.titleScale": { "min": 0.85, "max": 1.3 },
        "typography.bodyScale": { "min": 0.85, "max": 1.3 },
        "elevation.cardShadow": { "min": 0, "max": 1 },
        "elevation.dialogShadow": { "min": 0, "max": 1 },
        "elevation.heroScrim": { "min": 0.3, "max": 1 },
        "motion.focusZoom": { "min": 1, "max": 1.15 },
        "motion.crossfadeMs": { "min": 0, "max": 800 },
        "player.buttonScale": { "min": 0.8, "max": 1.4 },
        "player.playButtonScale": { "min": 0.8, "max": 1.6 },
        "player.seekBarScale": { "min": 0.8, "max": 2 },
        "player.labelScale": { "min": 0.85, "max": 1.3 },
        "background": true
      }
    }
  ]
}
