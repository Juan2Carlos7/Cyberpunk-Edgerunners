{
  "id": "theme-demon-slayer",
  "name": "Demon Slayer",
  "version": "1.0.0",
  "apiVersion": 26,
  "entry": "plugin.js",
  "description": "Tema Demon Slayer: Tanjiro, haori ajedrezado y llamas Hinokami",
  "hosts": [],
  "categories": ["themes"],
  "appThemes": [
    {
      "id": "tanjiro",
      "name": { "es": "Demon Slayer · Tanjiro", "en": "Demon Slayer · Tanjiro" },
      "experience": "full",
      "colors": {
        "accent": "#2FB67C", "onAccent": "#04140D",
        "background": "#070D0B", "surface": "#0F1A16",
        "surfaceHigh": "#16271F", "railPanel": "#0B1411",
        "focus": "#FF7A1A", "onFocus": "#000000",
        "border": "#1F5A41", "favorite": "#FF5A1F"
      },
      "background": { "type": "gradient", "colors": ["#070D0B", "#14090A"], "angle": 160 },
      "shape": {
        "cardRadius": 10, "channelRadius": 10, "buttonRadius": 12,
        "chipRadius": 8, "dialogRadius": 14, "inputRadius": 8,
        "cardBorder": 1, "dialogBorder": 2, "headerBorder": 1,
        "heroRadius": 18, "railItemRadius": 10
      },
      "typography": { "scale": 1.0, "titleScale": 1.1, "bodyScale": 1.0 },
      "elevation": { "cardShadow": 0.5, "dialogShadow": 0.8, "heroScrim": 0.75 },
      "motion": { "focusZoom": 1.08, "crossfadeMs": 300, "heroDrift": "on" },
      "player": { "buttonScale": 1.1, "playButtonScale": 1.3, "seekBarScale": 1.4, "buttonShape": "rounded" },
      "style": { "gloss": 0.3 },
      "layout": { "hero": "framed", "rail": "floating" },
      "surfaces": {
        "button": {
          "fill": { "type": "gradient", "colors": ["#3BD594", "#1E8A5C"], "angle": 180 },
          "stroke": { "width": 1, "color": "#8CF0C4" }
        },
        "navActive": {
          "fill": { "type": "solid", "color": "#0F2A1F" },
          "stroke": { "width": 1.5, "color": "#FF7A1A" },
          "glow": { "color": "#FF7A1A", "radius": 10, "alpha": 0.5 }
        },
        "cardFocus": {
          "stroke": { "width": 2, "gradient": { "type": "gradient", "colors": ["#FF7A1A", "#FFD27A"], "angle": 90 } },
          "glow": { "color": "#FF5A1F", "radius": 14, "alpha": 0.5 }
        },
        "card": { "glow": { "color": "#2FB67C", "radius": 8, "alpha": 0.18 } },
        "hero": {
          "stroke": { "width": 1.5, "color": "#2FB67C" },
          "glow": { "color": "#2FB67C", "radius": 16, "alpha": 0.3 }
        },
        "progress": { "fill": { "type": "gradient", "colors": ["#FF5A1F", "#FFB347"], "angle": 0 } }
      },
      "logo": {
        "wordmark": {
          "size": [120, 40],
          "paths": [
            { "d": "M20 38 C4 30 8 14 18 2 C20 12 30 14 30 26 C30 32 26 36 20 38 Z", "fill": "#FF7A1A" },
            { "d": "M40 8 H52 V20 H40 Z", "fill": "accent" },
            { "d": "M52 20 H64 V32 H52 Z", "fill": "accent" },
            { "d": "M52 8 H64 V20 H52 Z", "fill": "#0F3D2B" },
            { "d": "M40 20 H52 V32 H40 Z", "fill": "#0F3D2B" },
            { "d": "M76 14 H112 V18 H76 Z", "fill": "textPrimary" },
            { "d": "M76 24 H100 V28 H76 Z", "fill": "textSecondary" }
          ]
        },
        "mark": {
          "size": [40, 40],
          "paths": [
            { "d": "M0 0 H20 V20 H0 Z", "fill": "accent" },
            { "d": "M20 20 H40 V40 H20 Z", "fill": "accent" },
            { "d": "M20 0 H40 V20 H20 Z", "fill": "#0F3D2B" },
            { "d": "M0 20 H20 V40 H0 Z", "fill": "#0F3D2B" },
            { "d": "M20 8 C12 14 14 22 20 32 C26 22 28 14 20 8 Z", "fill": "#FF7A1A" }
          ]
        }
      },
      "adjustable": {
        "colors.accent": { "swatches": ["#2FB67C", "#FF7A1A", "#E5383B", "#F2C94C"] },
        "shape.cardRadius": { "min": 0, "max": 20 },
        "background": true
      }
    }
  ]
}
